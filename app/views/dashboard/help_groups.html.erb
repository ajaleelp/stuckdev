<div class="flex flex-col max-w-xl mx-auto mt-10">
  <div class="py-2">
    <% if @help_groups.empty? %>
      <div class="bg-orange-100 border-t-4 border-orange-500 rounded-b text-orange-900 px-4 py-3 shadow-md mb-10" role="alert">
        <div class="flex">
          <div class="py-1"><svg class="fill-current h-6 w-6 text-orange-500 mr-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M2.93 17.07A10 10 0 1 1 17.07 2.93 10 10 0 0 1 2.93 17.07zm12.73-1.41A8 8 0 1 0 4.34 4.34a8 8 0 0 0 11.32 11.32zM9 11V9h2v6H9v-4zm0-6h2v2H9V5z"/></svg></div>
          <div>
            <p class="font-bold mb-2">Start by adding help-groups your would like to reach out to!</p>
            <p class="text-sm">These could be anything: your own <strong>'Ruby Mentors'</strong>, the <strong>'AuthService Experts'</strong> in your team etc...</p>
          </div>
        </div>
      </div>
    <% end %>
    <% unless @help_groups.empty? %>
      <h2 class="text-xl pl-1 pb-1 font-semibold mt-8"">Groups</h2>
      <% @help_groups.each do |group| %>
        <div class="shadow rounded-lg mb-6 bg-white">
          <table class="min-w-full">
            <thead>
              <div class="flex justify-between">
                <div class="px-4 py-3"><%= group.name %></div>
                <% unless group.member_ids.empty? %>
                  <div class="border border-solid border-green-600 hover:bg-green-600 hover:text-white text-sm text-green-600 m-2 py-2 px-3 rounded flex">
                    <svg height="512pt" viewBox="0 0 512 512" width="12pt" xmlns="http://www.w3.org/2000/svg" class="h-5 mr-1 fill-current"><path d="m512 346.5c0-74.628906-50.285156-139.832031-121.195312-159.480469-4.457032-103.878906-90.347657-187.019531-195.304688-187.019531-107.800781 0-195.5 87.699219-195.5 195.5 0 35.132812 9.351562 69.339844 27.109375 99.371094l-26.390625 95.40625 95.410156-26.386719c27.605469 16.324219 58.746094 25.519531 90.886719 26.90625 19.644531 70.914063 84.851563 121.203125 159.484375 121.203125 29.789062 0 58.757812-7.933594 84.210938-23.007812l80.566406 22.285156-22.285156-80.566406c15.074218-25.453126 23.007812-54.421876 23.007812-84.210938zm-411.136719-15.046875-57.117187 15.800781 15.800781-57.117187-3.601563-5.632813c-16.972656-26.554687-25.945312-57.332031-25.945312-89.003906 0-91.257812 74.242188-165.5 165.5-165.5s165.5 74.242188 165.5 165.5-74.242188 165.5-165.5 165.5c-31.671875 0-62.445312-8.972656-89.003906-25.945312zm367.390625 136.800781-42.382812-11.726562-5.660156 3.683594c-21.941407 14.253906-47.433594 21.789062-73.710938 21.789062-58.65625 0-110.199219-37.925781-128.460938-92.308594 89.820313-10.355468 161.296876-81.832031 171.65625-171.65625 54.378907 18.265625 92.304688 69.808594 92.304688 128.464844 0 26.277344-7.535156 51.769531-21.789062 73.710938l-3.683594 5.660156zm0 0"/><path d="m180.5 271h30v30h-30zm0 0"/><path d="m225.5 150c0 8.519531-3.46875 16.382812-9.765625 22.144531l-35.234375 32.25v36.605469h30v-23.394531l25.488281-23.328125c12.398438-11.347656 19.511719-27.484375 19.511719-44.277344 0-33.085938-26.914062-60-60-60s-60 26.914062-60 60h30c0-16.542969 13.457031-30 30-30s30 13.457031 30 30zm0 0"/></svg>
                    <%= link_to 'Get Help', dashboard_path(help_group_id: group.id) %>
                  </div>
                <% end %>
              </div>
            </thead>
            <tbody class="bg-white">
            <% if group.member_ids.empty? %>
              <div class="bg-orange-100 border-l-4 border-orange-500 text-orange-700 p-4" role="alert">
                <p class="font-bold">No one here.</p>
                <p>Please add members to this group from the dropdown below.</p>
              </div>
            <% else %>
              <% group.member_ids.each do |user_id| %>
                <% user = User.find(user_id) %>
                <tr>
                  <td class="px-6 py-4 whitespace-no-wrap border-b border-gray-200">
                    <div class="flex items-center">
                      <div class="flex-shrink-0 h-10 w-10">
                        <img class="h-10 w-10 rounded-full" src="<%= image_path(user.picture) %>" alt="" />
                      </div>
                      <div class="ml-4">
                        <div class="text-sm leading-5 font-medium text-gray-900"><%= "#{user.first_name} #{user.last_name}" %></div>
                        <div class="text-sm leading-5 text-gray-500"><%= user.email %></div>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-no-wrap text-right border-b border-gray-200 text-sm leading-5 font-medium">
                    <%= form_with url: help_groups_remove_path, method: 'patch', local: true do |f| %>
                      <%= hidden_field_tag :group_id, :id, { value: group.id, id: "remove-#{group.id}-#{user_id}"} %>
                      <%= hidden_field_tag :user_id, :id, { value: user_id, id: "user_id-#{group.id}-#{user_id}"} %>
                      <%= f.submit 'Remove', class: 'text-indigo-600 hover:text-indigo-900 focus:outline-none focus:underline' %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% end %>
            </tbody>
          </table>
          <%= form_with url: help_groups_add_path, class: 'w-full p-4', method: 'patch', local: true do |f| %>
            <div class="flex">
              <%= hidden_field_tag :group_id, :id, { value: group.id, id: "add-#{group.id}" } %>
              <% invitable_users = User.where.not(id: current_user.id).where.not(id: group.member_ids) %>
              <%= f.select :user_id, invitable_users.collect {|u| [ u.email, u.id ] }, { prompt: 'Search by email' }, { class: 'js-select2 appearance-none bg-transparent border-none w-full text-gray-700 mr-3 py-1 px-2 leading-tight focus:outline-none', id: "select-#{group.id}", required: true } %>
              <%= f.submit 'Add', class: 'flex-1 flex-shrink-0 bg-green-600 hover:bg-green-700 text-sm text-white py-1 px-3 ml-3 rounded' %>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
    <div class="shadow rounded-lg bg-white">
      <div class="px-4 py-3">Create <%= @help_groups.empty? ? "your first" : "another" %> help group</div>
      <%= form_with url: help_groups_create_path, class: 'w-full p-4', local: true do |f| %>
        <div class="flex border-b border-b-2 border-green-500 py-1">
          <%= f.text_field :name, required: true, class: 'appearance-none bg-transparent border-none w-full text-gray-700 mr-3 py-2 px-2 leading-tight focus:outline-none', placeholder: 'Group Name' %>
          <%= f.submit 'Create', class: 'flex-1 flex-shrink-0 bg-green-600 hover:bg-green-700 text-sm text-white py-1 px-3 rounded' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
