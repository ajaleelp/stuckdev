<div class="flex flex-col  max-w-xl mx-auto mt-10">
  <div class="-my-2 py-2 overflow-x-auto sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8">
    <% @help_groups.each do |group| %>
      <div class="align-middle inline-block min-w-full shadow overflow-hidden sm:rounded-lg border-b border-gray-400 bg-gray-200 mb-10">
        <table class="min-w-full">
          <thead>
            <div class="px-6 py-3 text-green-500"><%= group.name %></div>
          </thead>
          <tbody class="bg-white">
          <% group.user_ids.each do |user_id| %>
            <% user = User.find(user_id) %>
            <tr>
              <td class="px-6 py-4 whitespace-no-wrap border-b border-gray-200">
                <div class="flex items-center">
                  <div class="flex-shrink-0 h-10 w-10">
                    <img class="h-10 w-10 rounded-full" src="<%= image_path(user.picture) %>" alt="" />
                  </div>
                  <div class="ml-4">
                    <div class="text-sm leading-5 font-medium text-gray-900"><%= "#{user.first_name} #{user.last_name}" %></div>
                    <div class="text-sm leading-5 text-gray-500"><%= user.email %></div>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-no-wrap text-right border-b border-gray-200 text-sm leading-5 font-medium">
                <%= form_with url: help_groups_remove_path, method: 'patch', local: true do |f| %>
                  <%= f.hidden_field :group_id, value: group.id %>
                  <%= f.hidden_field :user_id, value: user_id %>
                  <%= f.submit 'Remove', class: 'text-indigo-600 hover:text-indigo-900 focus:outline-none focus:underline' %>
                <% end %>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
        <%= form_with url: help_groups_add_path, class: 'w-full py-2 px-4', method: 'patch', local: true do |f| %>
          <div class="flex items-center border-b border-b-2 border-green-500 py-1">
            <%= f.hidden_field :group_id, value: group.id %>
            <%= f.text_field :email, class: 'appearance-none bg-transparent border-none w-full text-gray-700 mr-3 py-1 px-2 leading-tight focus:outline-none', placeholder: 'newmember@example.com' %>
            <%= f.submit 'Add', class: 'flex-shrink-0 bg-green-500 hover:bg-green-700 border-green-500 hover:border-green-700 text-sm border-4 text-white py-1/2 px-2 rounded' %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>