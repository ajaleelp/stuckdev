<div class="w-full max-w-5xl mx-auto mt-10">
  <form class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4" autocomplete="off">
    <div class="mb-4">
      <label class="block text-gray-700 text-sm mb-2" for="topic">
        Topic
      </label>
      <input class="font-mono text-sm shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" id="title" type="text" placeholder="The error message, maybe?">
    </div>
    <div class="mb-4">
      <label class="block text-gray-700 text-sm mb-2" for="details">
        Details
      </label>
      <textarea class="font-mono text-sm shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline" rows="20" placeholder="Your setup, the stack trace etc..."></textarea>
    </div>
    <div class="mb-6">
      <label class="block text-gray-700 text-sm mb-2" for="details">
        Group
      </label>
      <div class="relative">
        <select class="block text-sm appearance-none w-full bg-gray-200 border border-gray-200 text-gray-700 py-3 px-4 pr-8 rounded leading-tight focus:outline-none focus:bg-white focus:border-gray-500" id="grid-state">
          <% @help_group_names.each do |group_name| %>
            <option><%= group_name %></option>
          <% end %>
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-700">
          <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/></svg>
        </div>
      </div>
    </div>
    <div class="flex items-center">
      <button class="bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline" type="button">
        Ask Around
      </button>
    </div>
  </form>
  <p class="text-center text-gray-500 text-xs">
    &copy;2020 StuckDev. All rights reserved.
  </p>
</div>
</div>