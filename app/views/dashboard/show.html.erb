<div class="w-full max-w-5xl mx-auto mt-10">
  <form class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4" autocomplete="off">
    <div class="mb-4">
      <label class="block text-gray-700 text-sm mb-2" for="topic">
        Topic
      </label>
      <input class="font-mono shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" id="title" type="text" placeholder="The error message, maybe?">
    </div>
    <div class="mb-6">
      <label class="block text-gray-700 text-sm mb-2" for="details">
        Details
      </label>
      <textarea class="font-mono shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline" rows="20" placeholder="Your setup, the stack trace etc..."></textarea>
    </div>
    <div class="flex items-center">
      <button class="bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline" type="button">
        Ask Around
      </button>
    </div>
  </form>
  <p class="text-center text-gray-500 text-xs">
    &copy;2020 StuckDev. All rights reserved.
  </p>
</div>
</div>