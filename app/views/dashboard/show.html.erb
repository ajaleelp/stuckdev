<div class="w-full max-w-5xl mx-auto mt-10">
  <%= form_with model: @help_request, class: "bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4", local: true do |f| %>
    <div class="text-right">
    <%= link_to 'Code of Conduct', code_of_conduct_path, class: 'underline text-green-600', target: '_blank' %>
    </div>
    <%= f.label :topic, class: 'block text-gray-700 text-sm mb-2' %>
    <%= f.text_field :topic, required: true, placeholder: "The error message, maybe?", class: 'font-mono text-sm shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline mb-4' %>
    <%= f.label :details, class: 'block text-gray-700 text-sm mb-2' %>
    <%= f.text_area :details, required: true, rows: "20", placeholder: "Your setup, the stack trace etc...", class: 'font-mono text-sm shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 mb-3 leading-tight focus:outline-none focus:shadow-outline' %>
    <%= f.label :help_group_id, 'Group', class: 'block text-gray-700 text-sm mb-2' %>
    <div class="relative mb-6">
    <%= f.select :help_group_id, @help_groups.collect {|u| [ u.name, u.id ] }, { selected: params[:help_group_id] }, { required: true, class: 'block text-sm appearance-none w-full bg-gray-200 border border-gray-200 text-gray-700 py-3 px-4 pr-8 rounded leading-tight focus:outline-none focus:bg-white focus:border-gray-500' } %>
      <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-700">
        <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/></svg>
      </div>
    </div>
    <%= f.submit "Ask Around", class: 'bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline' %>
  <% end %>
  <p class="text-center text-gray-500 text-xs">
    &copy;2020 StuckDev. All rights reserved.
  </p>
</div>
</div>