<% content_for :head do %>
  <%= javascript_pack_tag 'help_availability_poll', 'data-turbolinks-track': 'reload' %>
<% end %>
<div class="max-w-xl mx-auto mt-10" id="wait-notice" data-request-id=<%= @help_request.id %>>
  <div class="rounded overflow-hidden shadow-lg">
    <img class="w-full" src="/wait.png">
    <div class="px-6 py-4">
      <div class="font-bold text-xl mb-2">We are on it!</div>
      <p class="text-gray-700 text-base">
        Please wait while we try to find someone from '<%= @help_request.help_group.name %>' to help you out. Watch out for StuckDev notifications :)
      </p>
    </div>
  </div>
</div>