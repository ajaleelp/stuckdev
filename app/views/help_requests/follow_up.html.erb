<div class="max-w-xl mx-auto mt-10" id="wait-notice" data-request-id=<%= @help_request.id %>>
  <div class="rounded overflow-hidden shadow-lg">
    <img class="w-full" src="/wait.png">
    <div class="px-6 py-4">
      <div class="font-bold text-xl mb-2">Did you get un-stuck? :)</div>
      <p class="text-gray-700 text-base">
        Did that session with <%= @help_request.current_helper.first_name %> help you out?
      </p>
      <div class="mt-4">
        <a href='#' class="bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded">
          Yes, I am free atlast!
        </a>
      </div>
      <div class="mt-4">
        <a href='#' class="bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded">
          Not yet. Connect with someone else.
        </a>
      </div>
    </div>
  </div>
</div>