<% content_for :head do %>
  <%= javascript_include_tag "https://meet.jit.si/external_api.js" %>
  <%= javascript_pack_tag 'jitsi', 'data-turbolinks-track': 'reload' %>
<% end %>
<div id="screen-share" class="w-screen h-screen"
     data-room-name='<%= "stuckdev-session-#{params[:id]}" %>'
     data-display-name='<%= current_user.first_name %>'
     data-avatar-url='<%= current_user.picture %>'
     data-is-owner=<%= @help_request.owner.id == current_user.id %>
     data-help-request-id=<%= @help_request.id %>></div>