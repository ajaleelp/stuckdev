<div class="max-w-xl mx-auto mt-10">
  <div class="rounded overflow-hidden shadow-lg">
    <img class="w-full" src="/wait.png">
    <div class="px-6 py-4">
      <div class="font-bold text-xl mb-2">Can you have look?</div>
      <p class="text-gray-700 text-base">
        This is what <%= @help_request.owner.first_name %> needs help with:
      </p>
      <div class="bg-grey-lighter border border-grey-light font-mono rounded p-2 whitespace-pre flex flex-col mt-4">
        <div class="text-md text-grey-darkest"><%= @help_request.topic %></div>
        <div class="text-sm text-grey-300 mt-2"><%= @help_request.details %></div>
      </div>
      <div class="mt-4">
        <a href='<%= connect_help_request_path(@help_request) %>' class="bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded">
          Connect
        </a>
      </div>
    </div>
  </div>
</div>